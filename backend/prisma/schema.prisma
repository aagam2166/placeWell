generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model companies {
  company_id            BigInt                  @id @default(autoincrement())
  name                  String
  industry              String?
  website               String?
  logo_url              String?
  company_skills        company_skills[]
  interview_experiences interview_experiences[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model company_skills {
  company_id BigInt
  skill_id   BigInt
  usage_type String?
  companies  companies @relation(fields: [company_id], references: [company_id], onDelete: Cascade, onUpdate: NoAction)
  skills     skills    @relation(fields: [skill_id], references: [skill_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([company_id, skill_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model interview_experiences {
  experience_id       BigInt      @id @default(autoincrement())
  user_id             BigInt?
  company_id          BigInt?
  role_title          String
  experience_type     String?
  year                Int?
  result              String?
  overall_difficulty  Int?
  ctc_or_stipend      String?
  total_rounds        Int?
  summary_text        String?
  is_anonymous_public Boolean?    @default(false)
  status              String?     @default("draft")
  created_at          DateTime?   @default(now()) @db.Timestamptz(6)
  companies           companies?  @relation(fields: [company_id], references: [company_id], onDelete: Cascade, onUpdate: NoAction)
  users               users?      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  resources           resources[]
  rounds              rounds[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model questions {
  question_id    BigInt  @id @default(autoincrement())
  round_id       BigInt?
  topic_id       BigInt?
  question_text  String
  question_type  String?
  difficulty     Int?
  reference_link String?
  rounds         rounds? @relation(fields: [round_id], references: [round_id], onDelete: Cascade, onUpdate: NoAction)
  topics         topics? @relation(fields: [topic_id], references: [topic_id], onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model resources {
  resource_id           BigInt                 @id @default(autoincrement())
  experience_id         BigInt?
  title                 String
  url                   String
  created_at            DateTime?              @default(now()) @db.Timestamptz(6)
  interview_experiences interview_experiences? @relation(fields: [experience_id], references: [experience_id], onUpdate: NoAction)
  skill_resources       skill_resources[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rounds {
  round_id              BigInt                 @id @default(autoincrement())
  experience_id         BigInt?
  topic_id              BigInt?
  round_number          Int?
  round_type            String?
  duration_minutes      Int?
  description_text      String?
  difficulty_rating     Int?
  platform_used         String?
  difficulty            Int?
  notes                 String?
  questions             questions[]
  interview_experiences interview_experiences? @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade, onUpdate: NoAction)
  topics                topics?                @relation(fields: [topic_id], references: [topic_id], onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model skill_resources {
  skill_id    BigInt
  resource_id BigInt
  resources   resources @relation(fields: [resource_id], references: [resource_id], onDelete: Cascade, onUpdate: NoAction)
  skills      skills    @relation(fields: [skill_id], references: [skill_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([skill_id, resource_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model skills {
  skill_id        BigInt            @id @default(autoincrement())
  skill_name      String
  company_skills  company_skills[]
  skill_resources skill_resources[]
  topics          topics[]
  user_skills     user_skills[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model topics {
  topic_id        BigInt      @id @default(autoincrement())
  skill_id        BigInt?
  topic_name      String
  parent_topic_id BigInt?
  category        String?
  questions       questions[]
  rounds          rounds[]
  topics          topics?     @relation("topicsTotopics", fields: [parent_topic_id], references: [topic_id], onDelete: Cascade, onUpdate: NoAction)
  other_topics    topics[]    @relation("topicsTotopics")
  skills          skills?     @relation(fields: [skill_id], references: [skill_id], onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_skills {
  user_id           BigInt
  skill_id          BigInt
  proficiency_level String?
  skills            skills  @relation(fields: [skill_id], references: [skill_id], onDelete: Cascade, onUpdate: NoAction)
  users             users   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, skill_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  user_id               BigInt                  @id @default(autoincrement())
  name                  String
  email                 String                  @unique
  password_hash         String?
  auth0_id              String?                 @unique
  college               String?
  branch                String?
  graduation_year       Int?
  phone                 String?
  created_at            DateTime?               @db.Timestamptz(6) @default(now())
  interview_experiences interview_experiences[]
  user_skills           user_skills[]
}
